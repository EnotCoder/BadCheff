[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

uniform float vignette_strength : hint_range(0.0, 2.0) = 0.65;
uniform float vignette_radius : hint_range(0.0, 2.0) = 0.85;
uniform float vignette_softness : hint_range(0.0, 1.0) = 0.45;

void fragment() {
	vec2 uv = SCREEN_UV;
	float dist = distance(uv, vec2(0.5));
	float vignette = smoothstep(vignette_radius, vignette_radius - vignette_softness, dist);
	COLOR = vec4(0.0, 0.0, 0.0, (1.0 - vignette) * vignette_strength);
}
"

