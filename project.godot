; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="badcheff"
config/description="This project demonstrates what you can be done with the Volumetrics Plugin."
run/main_scene="uid://cbdo7l5ro8ukn"
config/features=PackedStringArray("4.6")
config/icon="uid://ckayg2tlpi0an"

[autoload]

State="*res://enemy/State.gd"
Diolog="*res://Diolog.gd"
MainInventoryScript="*res://Player/Inventory/main_inventory_script.gd"

[debug]

settings/fps/force_fps=60

[display]

window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("silicon.vfx.volumetrics")

[filesystem]

import/blender/enabled=false

[importer_defaults]

texture_3d={
"compress/mode": 0,
"compress/no_bptc_if_rgb": false,
"flags/filter": true,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 1,
"slices/horizontal": 8,
"slices/vertical": 16
}

